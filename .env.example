APP_ENV=production
LOG_LEVEL=INFO

# Database Configuration (TimescaleDB / PostgreSQL / SQLite local)
DATABASE_URL=sqlite+aiosqlite:///./kripto_agent.db
SYNC_DATABASE_URL=sqlite:///./kripto_agent.db
REDIS_URL=redis://localhost:6379/0

# Exchange Configuration (Read-Only / Testnet)
EXCHANGE_NAME=binance
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_TESTNET=false
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_ENV=production_market_data

# STRICT LIVE TRADING GUARDRAILS
PAPER_TRADING=true
LIVE_TRADING=false
LIVE_TRADING_ARMED=false

# V2 7-Day $5,000 Experiment Configuration
EXPERIMENT_NAME=7_DAY_5000_PAPER_TEST
INITIAL_CAPITAL=5000.0
BASE_CURRENCY=USDT

# R10 RSI Divergence Configuration (Original Disciplined Protocol)
R10_ENABLED=true
R10_TIMEFRAME=15m
R10_RSI_LENGTH=14
R10_PIVOT_LEFT=5
R10_PIVOT_RIGHT=2
R10_CONFIRMATION_ENABLED=true

# Risk Management (Original Protocol: 1.0% Risk / $100 Target)
RISK_PER_TRADE=0.005
DAILY_MAX_LOSS=50.0
DAILY_TARGET=50.0
DAILY_TARGET_MIN=35.0
DAILY_TARGET_MAX=50.0
TARGET_MODE=HARD
MAX_TRADES_PER_DAY=5
MAX_OPEN_POSITIONS=2
MAX_POSITION_EQUITY_RATIO=0.20
LEVERAGE=1.0

# Execution & Cost Simulation
EXECUTION_STYLE=TAKER
MAKER_FEE=0.001
TAKER_FEE=0.001
SLIPPAGE_BPS=5.0
MAX_SPREAD_BPS=15.0
MIN_24H_VOLUME_USDT=500000.0
MAX_UNIVERSE_SYMBOLS=200

# Strategy & Signal Tuning
ATR_SL_MULTIPLIER=1.5
MIN_RISK_REWARD=1.5
PREFERRED_RISK_REWARD=2.0
MIN_SIGNAL_SCORE=65.0
MIN_OPPORTUNITY_SCORE=50.0

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=false

# API Server & Security
API_HOST=127.0.0.1
API_PORT=8000
API_KEY_AUTH_ENABLED=true
API_KEY_AUTH_BYPASS_DEV=false
API_ADMIN_KEY=kripto_admin_api_key_v6_production_safe_token_2026
API_AUTH_SECRET=kripto_auth_secret_token_v6_production_safe_jwt_2026

MIN_NET_RISK_REWARD=1.5
