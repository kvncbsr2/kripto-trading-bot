# BINANCE SPOT TESTNET / DEMO CONFIGURATION
# Generate keys from https://testnet.binance.vision/
BINANCE_API_KEY=your_binance_testnet_api_key_here
BINANCE_API_SECRET=your_binance_testnet_api_secret_here
BINANCE_ENV=testnet

# DECOUPLED ARCHITECTURE: REAL DATA + PAPER EXECUTION
MARKET_DATA_SOURCE=binance
EXECUTION_MODE=paper

# STRICT CODE-LEVEL SAFETY LOCKS (NEVER SET LIVE_TRADING=true)
PAPER_TRADING=true
LIVE_TRADING=false

# 7-DAY $5,000 EXPERIMENT RISK LIMITS
INITIAL_CAPITAL=5000.0
RISK_PER_TRADE=0.005
DAILY_MAX_LOSS=50.0
MAX_OPEN_POSITIONS=2
MAX_TRADES_PER_DAY=5
LEVERAGE=1.0

# R10 RSI DIVERGENCE SWING STRATEGY
R10_ENABLED=true
R10_TIMEFRAME=1d
R10_RSI_LENGTH=14
R10_PIVOT_LEFT=5
R10_PIVOT_RIGHT=5
R10_CONFIRMATION_ENABLED=true

# DATABASE & MONITORING
DATABASE_URL=sqlite+aiosqlite:///./kripto_agent.db
REDIS_URL=redis://localhost:6379/0
API_HOST=0.0.0.0
API_PORT=8000
