+def create_r10_strategy_from_settings(settings: Optional[object] = None) -> "R10RSIDivergenceStrategy":
+    """
+    SINGLE SOURCE OF TRUTH factory for R10RSIDivergenceStrategy.
+
+    FIX (2026-09): Previously, `autonomous_runner.py`, `market.py`, `signals.py` and
+    `strategy_manager.py` each instantiated `R10RSIDivergenceStrategy()` independently —
+    the live bot read `.env`/settings, but the API routers and the strategy registry
+    silently used the class's hardcoded defaults. If `.env` was ever changed, those
+    three call sites would keep using stale values without any error.
+
+    All call sites must now use this factory instead of calling the class directly,
+    so a single `.env` change is guaranteed to propagate everywhere.
+    """
+    if settings is None:
+        from shared.config import get_settings
+
+        settings = get_settings()
+
+    return R10RSIDivergenceStrategy(
+        left_bars=settings.R10_PIVOT_LEFT,
+        right_bars=settings.R10_PIVOT_RIGHT,
+        min_signal_score=settings.MIN_SIGNAL_SCORE,
+        timeframe=settings.R10_TIMEFRAME,
+    )
